{
  "manifest_version": 2,
  "name": "FoxAni",
  "version": "1.1",
  "description": "Exports bookmarks based on folder naming scheme / whitelist",

  "icons": {
    "48": "icons/Horikita-48.png",
    "96": "icons/Horikita-96.png"
  },

  "permissions": [
    "bookmarks",
    "downloads",
    "https://api.jikan.moe/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_title": "FoxAni Export",
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "foxani@local",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}